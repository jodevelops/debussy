# Kuratierwerkbank — Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# .env wird NIE ins Git-Repository committed.

# GPUStack-Verbindung
KWB_GPUSTACK_URL=
KWB_GPUSTACK_KEY=

# Modelle (Namen wie in GPUStack konfiguriert)
KWB_GPUSTACK_MODEL_TEXT=gpt-oss-120b
KWB_GPUSTACK_MODEL_VISION=internvl3-8b-instruct

# Verarbeitung
KWB_BATCH_SIZE=50
KWB_BATCH_DELAY=0.1
KWB_TIMEOUT=120

# Sprache (de/en)
KWB_LANGUAGE=de
